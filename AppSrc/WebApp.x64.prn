38379>>>>>        WebSet pbRender of oNewButton to True
38380>>>>>        WebSet pbRender of oDetailButton to True
38381>>>>>
38381>>>>>        Case Begin
38381>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38383>>>>>                // If from parent, this is a constrained drill down
38383>>>>>                // If Row select does main-zoom we don't need this
38383>>>>>                WebSet pbRender of oDetailButton to False
38384>>>>>                Case Break
38385>>>>>
38385>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38388>>>>>                // If from child, this is a probably a parent lookup from a Zoom
38388>>>>>                Case Break
38389>>>>>
38389>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38392>>>>>                // If from main, this is a probably a main-file lookup from a Zoom
38392>>>>>                WebSet pbRender of oDetailButton to False
38393>>>>>                Case Break
38394>>>>>
38394>>>>>            Case Else // must be nfUndefined
38394>>>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38394>>>>>                // If Row select does main-zoom we don't need this
38394>>>>>                WebSet pbRender of oDetailButton to False
38395>>>>>
38395>>>>>        Case End
38395>>>>>
38395>>>>>    End_Procedure
