37584>>>>>>>
37584>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37587>>>>>>>        Case Begin
37587>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37589>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37589>>>>>>>                Case Break
37590>>>>>>>
37590>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37593>>>>>>>                // If from parent, this is a constrained drill down.
37593>>>>>>>                Case Break
37594>>>>>>>
37594>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37597>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37597>>>>>>>                Case Break
37598>>>>>>>
37598>>>>>>>            Case Else // must be nfUndefined
37598>>>>>>>
37598>>>>>>>        Case End
37598>>>>>>>
37598>>>>>>>        Send SetActionButtons
37599>>>>>>>
37599>>>>>>>    End_Procedure
37600>>>>>>>
37600>>>>>>>End_Object 
