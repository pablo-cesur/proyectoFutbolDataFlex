38364>>>>>        Case Begin
38364>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
38366>>>>>                // If from parent, this is a constrained drill down
38366>>>>>                // If Row select does main-zoom we don't need this
38366>>>>>                WebSet pbRender of oDetailButton to False
38367>>>>>                Case Break
38368>>>>>
38368>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
38371>>>>>                // If from child, this is a probably a parent lookup from a Zoom
38371>>>>>                Case Break
38372>>>>>
38372>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
38375>>>>>                // If from main, this is a probably a main-file lookup from a Zoom
38375>>>>>                WebSet pbRender of oDetailButton to False
38376>>>>>                Case Break
38377>>>>>
38377>>>>>            Case Else // must be nfUndefined
38377>>>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38377>>>>>                // If Row select does main-zoom we don't need this
38377>>>>>                WebSet pbRender of oDetailButton to False
38378>>>>>
38378>>>>>        Case End
38378>>>>>
38378>>>>>    End_Procedure
