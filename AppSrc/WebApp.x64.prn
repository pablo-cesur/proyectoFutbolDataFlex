37522>>>>>>>    Procedure SetActionButtons
37525>>>>>>>        tWebNavigateData NavigateData
37525>>>>>>>        tWebNavigateData NavigateData
37525>>>>>>>        Boolean bHasRecord
37525>>>>>>>        Handle hoDD
37525>>>>>>>
37525>>>>>>>        Get Server to hoDD
37526>>>>>>>        Get GetNavigateData to NavigateData
37527>>>>>>>        Get HasRecord of hoDD to bHasRecord
37528>>>>>>>
37528>>>>>>>        // let's hide all buttons and then Show the ones we want
37528>>>>>>>        WebSet pbRender of oEditBtn to False
37529>>>>>>>        WebSet pbRender of oSaveBtn to False
37530>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37531>>>>>>>        WebSet pbRender of oDeleteBtn to False
37532>>>>>>>
37532>>>>>>>        If (NavigateData.bReadOnly) Begin
37534>>>>>>>            WebSet pbRender of oEditBtn to True
37535>>>>>>>        End
37535>>>>>>>>
37535>>>>>>>        Else Begin
37536>>>>>>>            WebSet pbRender of oSaveBtn to True
37537>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37538>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37539>>>>>>>        End
37539>>>>>>>>
37539>>>>>>>    End_Procedure
37540>>>>>>>
37540>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37543>>>>>>>        // Close after save
37543>>>>>>>        Send NavigateClose Self
37544>>>>>>>    End_Procedure
37545>>>>>>>
37545>>>>>>>    // this will close the view after a delete
37545>>>>>>>    Procedure OnViewDeleted Handle hoDDO
37548>>>>>>>        Send NavigateClose Self
37549>>>>>>>    End_Procedure
37550>>>>>>>
37550>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37553>>>>>>>        Case Begin
37553>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37555>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37555>>>>>>>                Case Break
37556>>>>>>>
37556>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37559>>>>>>>                // If from parent, this is a constrained drill down.
37559>>>>>>>                Case Break
37560>>>>>>>
37560>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37563>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37563>>>>>>>                Case Break
37564>>>>>>>
37564>>>>>>>            Case Else // must be nfUndefined
37564>>>>>>>
37564>>>>>>>        Case End
37564>>>>>>>
37564>>>>>>>        Send SetActionButtons
37565>>>>>>>
37565>>>>>>>    End_Procedure
37566>>>>>>>
37566>>>>>>>End_Object 
