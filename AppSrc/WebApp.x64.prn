37567>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37570>>>>>>>        Case Begin
37570>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37572>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37572>>>>>>>                Case Break
37573>>>>>>>
37573>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37576>>>>>>>                // If from parent, this is a constrained drill down.
37576>>>>>>>                Case Break
37577>>>>>>>
37577>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37580>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37580>>>>>>>                Case Break
37581>>>>>>>
37581>>>>>>>            Case Else // must be nfUndefined
37581>>>>>>>
37581>>>>>>>        Case End
37581>>>>>>>
37581>>>>>>>        Send SetActionButtons
37582>>>>>>>
37582>>>>>>>    End_Procedure
37583>>>>>>>
37583>>>>>>>End_Object 
