38269>>>    Procedure SetActionButtons
38272>>>        tWebNavigateData NavigateData
38272>>>        tWebNavigateData NavigateData
38272>>>        Boolean bHasRecord
38272>>>        Handle hoDD
38272>>>
38272>>>        Get Server to hoDD
38273>>>        Get GetNavigateData to NavigateData
38274>>>        Get HasRecord of hoDD to bHasRecord
38275>>>
38275>>>        // let's hide all buttons and then Show the ones we want
38275>>>        WebSet pbRender of oEditBtn to False
38276>>>        WebSet pbRender of oSaveBtn to False
38277>>>        WebSet pbRender of oCancelChangesBtn to False
38278>>>        WebSet pbRender of oDeleteBtn to False
38279>>>
38279>>>        If (NavigateData.bReadOnly) Begin
38281>>>            WebSet pbRender of oEditBtn to True
38282>>>        End
38282>>>>
38282>>>        Else Begin
38283>>>            WebSet pbRender of oSaveBtn to True
38284>>>            WebSet pbRender of oCancelChangesBtn to True
38285>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38286>>>        End
38286>>>>
38286>>>    End_Procedure
38287>>>
38287>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38290>>>        // Close after save
38290>>>        Send NavigateClose Self
38291>>>    End_Procedure
38292>>>
38292>>>    // this will close the view after a delete
38292>>>    Procedure OnViewDeleted Handle hoDDO
38295>>>        Send NavigateClose Self
38296>>>    End_Procedure
38297>>>
38297>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38300>>>        Case Begin
38300>>>            Case (NavigateData.eNavigateType = nfFromMain)
38302>>>                // If from main, this is a propbably a main file Select to Zoom.
38302>>>                Case Break
38303>>>
38303>>>            Case (NavigateData.eNavigateType = nfFromParent)
38306>>>                // If from parent, this is a constrained drill down.
38306>>>                Case Break
38307>>>
38307>>>            Case (NavigateData.eNavigateType = nfFromChild)
38310>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38310>>>                Case Break
38311>>>
38311>>>            Case Else // must be nfUndefined
38311>>>
38311>>>        Case End
38311>>>
38311>>>        Send SetActionButtons
38312>>>
38312>>>    End_Procedure
38313>>>
38313>>>End_Object 
