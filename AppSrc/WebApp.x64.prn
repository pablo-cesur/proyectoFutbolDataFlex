37573>>>>>>>    Procedure SetActionButtons
37576>>>>>>>        tWebNavigateData NavigateData
37576>>>>>>>        tWebNavigateData NavigateData
37576>>>>>>>        Boolean bHasRecord
37576>>>>>>>        Handle hoDD
37576>>>>>>>
37576>>>>>>>        Get Server to hoDD
37577>>>>>>>        Get GetNavigateData to NavigateData
37578>>>>>>>        Get HasRecord of hoDD to bHasRecord
37579>>>>>>>
37579>>>>>>>        // let's hide all buttons and then Show the ones we want
37579>>>>>>>        WebSet pbRender of oEditBtn to False
37580>>>>>>>        WebSet pbRender of oSaveBtn to False
37581>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37582>>>>>>>        WebSet pbRender of oDeleteBtn to False
37583>>>>>>>        //Añadimos para que aparezca solo si hay un jugador cargado
37583>>>>>>>        WebSet pbRender of oBtnVerPosiciones to bHasRecord
37584>>>>>>>
37584>>>>>>>        If (NavigateData.bReadOnly) Begin
37586>>>>>>>            WebSet pbRender of oEditBtn to True
37587>>>>>>>        End
37587>>>>>>>>
37587>>>>>>>        Else Begin
37588>>>>>>>            WebSet pbRender of oSaveBtn to True
37589>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37590>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37591>>>>>>>        End
37591>>>>>>>>
37591>>>>>>>    End_Procedure
