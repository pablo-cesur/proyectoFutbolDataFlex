37602>>>>>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37605>>>>>>>        Case Begin
37605>>>>>>>            Case (NavigateData.eNavigateType = nfFromMain)
37607>>>>>>>                // If from main, this is a propbably a main file Select to Zoom.
37607>>>>>>>                Case Break
37608>>>>>>>
37608>>>>>>>            Case (NavigateData.eNavigateType = nfFromParent)
37611>>>>>>>                // If from parent, this is a constrained drill down.
37611>>>>>>>                Case Break
37612>>>>>>>
37612>>>>>>>            Case (NavigateData.eNavigateType = nfFromChild)
37615>>>>>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37615>>>>>>>                Case Break
37616>>>>>>>
37616>>>>>>>            Case Else // must be nfUndefined
37616>>>>>>>
37616>>>>>>>        Case End
37616>>>>>>>
37616>>>>>>>        Send SetActionButtons
37617>>>>>>>
37617>>>>>>>    End_Procedure
37618>>>>>>>
37618>>>>>>>End_Object 
