38229>>>>>>>
38229>>>>>>>        // let's hide all buttons and then Show the ones we want
38229>>>>>>>        WebSet pbRender of oEditBtn to False
38230>>>>>>>        WebSet pbRender of oSaveBtn to False
38231>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
38232>>>>>>>        WebSet pbRender of oDeleteBtn to False
38233>>>>>>>        WebSet pbRender of oBtnVerEquipos to True
38234>>>>>>>
38234>>>>>>>        If (NavigateData.bReadOnly) Begin
38236>>>>>>>            WebSet pbRender of oEditBtn to True
38237>>>>>>>        End
