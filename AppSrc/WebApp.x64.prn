37556>>>>>>>    Procedure SetActionButtons
37559>>>>>>>        tWebNavigateData NavigateData
37559>>>>>>>        tWebNavigateData NavigateData
37559>>>>>>>        Boolean bHasRecord
37559>>>>>>>        Handle hoDD
37559>>>>>>>
37559>>>>>>>        Get Server to hoDD
37560>>>>>>>        Get GetNavigateData to NavigateData
37561>>>>>>>        Get HasRecord of hoDD to bHasRecord
37562>>>>>>>
37562>>>>>>>        // let's hide all buttons and then Show the ones we want
37562>>>>>>>        WebSet pbRender of oEditBtn to False
37563>>>>>>>        WebSet pbRender of oSaveBtn to False
37564>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37565>>>>>>>        WebSet pbRender of oDeleteBtn to False
37566>>>>>>>
37566>>>>>>>        If (NavigateData.bReadOnly) Begin
37568>>>>>>>            WebSet pbRender of oEditBtn to True
37569>>>>>>>        End
37569>>>>>>>>
37569>>>>>>>        Else Begin
37570>>>>>>>            WebSet pbRender of oSaveBtn to True
37571>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37572>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37573>>>>>>>        End
37573>>>>>>>>
37573>>>>>>>    End_Procedure
