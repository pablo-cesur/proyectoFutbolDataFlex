37539>>>>>>>    Procedure SetActionButtons
37542>>>>>>>        tWebNavigateData NavigateData
37542>>>>>>>        tWebNavigateData NavigateData
37542>>>>>>>        Boolean bHasRecord
37542>>>>>>>        Handle hoDD
37542>>>>>>>
37542>>>>>>>        Get Server to hoDD
37543>>>>>>>        Get GetNavigateData to NavigateData
37544>>>>>>>        Get HasRecord of hoDD to bHasRecord
37545>>>>>>>
37545>>>>>>>        // let's hide all buttons and then Show the ones we want
37545>>>>>>>        WebSet pbRender of oEditBtn to False
37546>>>>>>>        WebSet pbRender of oSaveBtn to False
37547>>>>>>>        WebSet pbRender of oCancelChangesBtn to False
37548>>>>>>>        WebSet pbRender of oDeleteBtn to False
37549>>>>>>>
37549>>>>>>>        If (NavigateData.bReadOnly) Begin
37551>>>>>>>            WebSet pbRender of oEditBtn to True
37552>>>>>>>        End
37552>>>>>>>>
37552>>>>>>>        Else Begin
37553>>>>>>>            WebSet pbRender of oSaveBtn to True
37554>>>>>>>            WebSet pbRender of oCancelChangesBtn to True
37555>>>>>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37556>>>>>>>        End
37556>>>>>>>>
37556>>>>>>>    End_Procedure
37557>>>>>>>
37557>>>>>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
37560>>>>>>>        // Close after save
37560>>>>>>>        Send NavigateClose Self
37561>>>>>>>    End_Procedure
37562>>>>>>>
37562>>>>>>>    // this will close the view after a delete
37562>>>>>>>    Procedure OnViewDeleted Handle hoDDO
